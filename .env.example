# Copy to .env and fill in real values. Never commit .env.
# New variables are added here in the same commit that introduces them.

# App
APP_ENV=local
LOG_LEVEL=INFO

# Database (SQLite file; switch to PostgreSQL by changing only this URL)
DATABASE_URL=sqlite+aiosqlite:///./warden.db

# Auth: JSON map of API key -> caller name and role (viewer | operator | admin).
# Dev-only dummy keys; use long random keys for anything shared.
API_KEYS={"viewer-dev-key": {"name": "vera", "role": "viewer"}, "operator-dev-key": {"name": "oscar", "role": "operator"}, "admin-dev-key": {"name": "ada", "role": "admin"}}
AUTH_EXEMPT_PATHS=["/api/v1/health", "/docs", "/openapi.json"]

# LLM provider: groq | gemini
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=4

# Groq (OpenAI-compatible API). Prices are USD per million tokens.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_INPUT_PRICE_PER_MTOK=0.15
GROQ_OUTPUT_PRICE_PER_MTOK=0.60

# MCP servers (started by the app as `python -m <module>` over stdio)
MCP_SERVER_MODULES={"warehouse": "mcp_servers.warehouse.server", "github": "mcp_servers.github.server", "notifier": "mcp_servers.notifier.server"}
MCP_TOOL_TIMEOUT_SECONDS=60

# warehouse server (seed with: uv run python -m mcp_servers.warehouse.seed)
WAREHOUSE_DB_PATH=data/warehouse.db
WAREHOUSE_CSV_PATH=data/orders.csv
WAREHOUSE_MAX_ROWS=200

# github server: dry-run never calls GitHub; live needs a fine-grained token for GITHUB_REPO only
GITHUB_MODE=dry-run
GITHUB_REPO=your-user/warden-sandbox
GITHUB_TOKEN=your-fine-grained-token
GITHUB_API_URL=https://api.github.com

# notifier server (mock outbox)
NOTIFIER_DB_PATH=data/notifier.db

# Gemini. Prices are USD per million tokens.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_INPUT_PRICE_PER_MTOK=0.30
GEMINI_OUTPUT_PRICE_PER_MTOK=2.50
